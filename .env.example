# Copy to .env.local for local dev, and set the same key(s) under
# Vercel -> Project -> Settings -> Environment Variables for production.

# URL of the backend API (Express + MongoDB, deployed on Render).
# All portfolio content, the contact form, and the admin dashboard
# talk to this. See backend/.env.example for the backend's own config.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Google Search Console site verification meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
