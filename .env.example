# Copy this file to .env.local for local dev, and add the same keys
# under Vercel → Project → Settings → Environment Variables for production.

# Contact form (Gmail example — use a 16-character App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=your_email@gmail.com
CONTACT_TO_EMAIL=your_email@gmail.com

# Optional: Google Search Console site verification meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
