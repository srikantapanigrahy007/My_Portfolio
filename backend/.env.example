# Copy to .env for local dev. On Render, set these under
# Dashboard -> your service -> Environment.

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Long random string used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login password (plaintext env var — fine for a single-admin site).
# Prefer ADMIN_PASSWORD_HASH instead if you want it hashed at rest:
# node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_PASSWORD_HASH=

# Comma-separated list of origins allowed to call this API (your Vercel
# frontend URL, plus localhost for dev). Leave empty to allow all (dev only).
FRONTEND_URL=http://localhost:3000,https://srikantapanigrahy.vercel.app

PORT=4000

# Contact form (Gmail example — use a 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=your_email@gmail.com
CONTACT_TO_EMAIL=your_email@gmail.com
